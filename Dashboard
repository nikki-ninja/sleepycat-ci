function renderTodayKpis() {
  const today = DAILY[0], yest = DAILY[1];
  const pct = (a,b) => b === 0 ? null : ((a-b)/b*100);
  const fmtDelta = (v) => {
    if (v === null) return `<span class="kpi-delta neu">—</span>`;
    const cls = v >= 0 ? 'pos' : 'neg';
    const arrow = v >= 0 ? '↑' : '↓';
    return `<span class="kpi-delta ${cls}">${arrow} ${Math.abs(v).toFixed(1)}% vs ${yest.date}</span>`;
  };
  const aov = Math.round(today.sales/today.orders);
  const aovY = Math.round(yest.sales/yest.orders);
  const cards = [
    { label: `Sessions (${today.date})`, value: today.sessions.toLocaleString('en-IN'), delta: fmtDelta(pct(today.sessions,yest.sessions)) },
    { label: 'ATC', value: today.atc.toLocaleString('en-IN'), delta: `<span class="kpi-delta neu">ATC rate ${today.atc_pct.toFixed(2)}%</span>` },
    { label: 'Orders (D2C online)', value: today.orders.toLocaleString('en-IN'), delta: fmtDelta(pct(today.orders,yest.orders)), flag: true },
    { label: 'Revenue (D2C)', value: '₹' + (today.sales/100000).toFixed(1) + 'L', delta: fmtDelta(pct(today.sales,yest.sales)) },
    { label: 'AOV (D2C)', value: '₹' + aov.toLocaleString('en-IN'), delta: fmtDelta(pct(aov,aovY)) },
    { label: 'CVR = orders/sessions', value: today.cvr_pct.toFixed(2)+'%', delta: fmtDelta(pct(today.cvr_pct,yest.cvr_pct)), flag: today.cvr_pct < 0.55 }
  ];
  document.getElementById('todayKpiRow').innerHTML = cards.map(c => `<div class="kpi-card${c.flag?' neg-flag':''}"><div class="kpi-label">${c.label}</div><div class="kpi-value">${c.value}</div>${c.delta}</div>`).join('');
  document.getElementById('topChip1').textContent = `CVR ${today.date.slice(5)} ${today.cvr_pct.toFixed(2)}%`;

  const orderDelta = pct(today.orders, yest.orders);
  const sessDelta = pct(today.sessions, yest.sessions);
  const syncNote = Math.abs(orderDelta - sessDelta) > 5
    ? "orders and sessions are moving out of sync, meaning conversion efficiency itself shifted, not just traffic volume."
    : "orders and sessions are moving roughly together, meaning today's change is mostly a traffic-volume story rather than a conversion-efficiency story.";
  document.getElementById('todayAnalystBody').innerHTML =
    `${today.date} vs ${yest.date}: D2C orders ${orderDelta>=0?'up':'down'} ${Math.abs(orderDelta).toFixed(1)}% (${yest.orders} → ${today.orders}) while sessions ${sessDelta>=0?'up':'down'} ${Math.abs(sessDelta).toFixed(1)}% — ${syncNote}<span class="rec">→ Store orders same day: 275 (separate channel, see Store KPIs below) — D2C and store volumes are within ${Math.abs(today.orders-275)} orders of each other.</span>`;
}
