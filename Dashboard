<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sleepycat · Product Analytics</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
  :root {
    --surface-0: #f6f1e7; --surface-1: #fbf8f1; --surface-2: #ffffff;
    --text-primary: #2b2018; --text-secondary: #5e5040; --text-muted: #948572;
    --border: rgba(43,32,24,0.10); --border-strong: rgba(43,32,24,0.18);
    --plum: #6b4226; --plum-light: #8a5a36; --mustard: #e0b64a; --mustard-light: #faf1da; --mustard-dark: #8a6a1f;
    --bg-accent: #f2e9de; --text-accent: #6b4226;
    --bg-success: #e6f2e2; --text-success: #2f6b1f;
    --bg-danger: #fbe8e4; --text-danger: #a5401f;
    --bg-warning: #fbf0d9; --text-warning: #8a5f0c;
    --radius: 8px; --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --surface-0: #17130f; --surface-1: #1d1813; --surface-2: #262019;
      --text-primary: #f3ede2; --text-secondary: #cbbfa9; --text-muted: #948572;
      --border: rgba(255,255,255,0.10); --border-strong: rgba(255,255,255,0.18);
      --plum: #b08a5f; --plum-light: #c9a679; --mustard: #dcbb63; --mustard-light: #332c17; --mustard-dark: #e8d29a;
      --bg-accent: #2e2620; --text-accent: #c9a679;
      --bg-success: #1c3213; --text-success: #a8d99a;
      --bg-danger: #3a1e17; --text-danger: #f5a58c;
      --bg-warning: #3a2c0f; --text-warning: #f0c674;
    }
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font-sans); background: var(--surface-0); color: var(--text-primary); font-size: 14px; line-height: 1.5; }
  .app { display: flex; height: 100vh; overflow: hidden; }
  .sidebar { width: 228px; flex-shrink: 0; background: var(--plum); color: #f3ede8; display: flex; flex-direction: column; overflow-y: auto; }
  .sidebar-header { padding: 18px 16px 14px; border-bottom: 1px solid rgba(255,255,255,0.14); }
  .brand-row { display: flex; align-items: center; gap: 8px; }
  .brand-mark { width: 26px; height: 26px; border-radius: 7px; background: var(--mustard); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 500; color: #2b2018; flex-shrink: 0; }
  .brand { font-size: 14px; font-weight: 500; color: #fff; letter-spacing: -0.2px; }
  .brand-sub { font-size: 10.5px; color: rgba(243,237,232,0.6); margin-top: 3px; }
  .nav-section { padding: 13px 8px 2px; }
  .nav-label { font-size: 9.5px; font-weight: 500; color: rgba(243,237,232,0.42); text-transform: uppercase; letter-spacing: 0.7px; padding: 0 8px; margin-bottom: 4px; }
  .nav-item { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 6px; cursor: pointer; font-size: 12.5px; color: rgba(243,237,232,0.8); transition: background 0.12s; border: none; background: none; width: 100%; text-align: left; }
  .nav-item:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .nav-item.active { background: var(--mustard); color: #2b2018; font-weight: 500; }
  .nav-icon { width: 16px; text-align: center; font-size: 14px; flex-shrink: 0; }
  .updated-badge { margin-top: auto; padding: 12px 16px; font-size: 10px; color: rgba(243,237,232,0.42); border-top: 1px solid rgba(255,255,255,0.14); line-height: 1.5; }
  .site-link { display: block; padding: 8px 16px 4px; font-size: 11px; color: rgba(243,237,232,0.65); text-decoration: none; }
  .site-link:hover { color: #fff; }
  .main { flex: 1; overflow-y: auto; background: var(--surface-0); }
  .topbar { position: sticky; top: 0; z-index: 10; background: var(--surface-0); border-bottom: 0.5px solid var(--border); padding: 0 24px; height: 52px; display: flex; align-items: center; justify-content: space-between; }
  .page-title { font-size: 15px; font-weight: 500; }
  .topbar-right { display: flex; align-items: center; gap: 8px; }
  .chip { font-size: 11.5px; padding: 4px 10px; border-radius: 20px; background: var(--bg-success); color: var(--text-success); font-weight: 500; }
  .chip.warn { background: var(--bg-warning); color: var(--text-warning); }
  .chip.danger { background: var(--bg-danger); color: var(--text-danger); }
  .date-label { font-size: 11.5px; color: var(--text-muted); }
  .content { padding: 20px 24px 44px; display: none; }
  .content.active { display: block; }
  .kpi-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(148px, 1fr)); gap: 10px; margin-bottom: 18px; }
  .kpi-card { background: var(--surface-2); border: 0.5px solid var(--border); border-radius: 12px; padding: 13px 15px; }
  .kpi-card.neg-flag { border-color: var(--text-danger); border-width: 1px; }
  .kpi-label { font-size: 10.5px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
  .kpi-value { font-size: 21px; font-weight: 500; color: var(--text-primary); line-height: 1; margin-bottom: 4px; }
  .kpi-delta { font-size: 11.5px; display: flex; align-items: center; gap: 3px; }
  .kpi-delta.pos { color: var(--text-success); } .kpi-delta.neg { color: var(--text-danger); } .kpi-delta.neu { color: var(--text-muted); }
  .analyst-note { background: var(--plum); color: #f3ede8; border-radius: 12px; padding: 14px 18px; margin-bottom: 18px; }
  .analyst-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .analyst-head-left { display: flex; align-items: center; gap: 8px; }
  .analyst-avatar { width: 22px; height: 22px; border-radius: 6px; background: var(--mustard); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 500; color: #2b2018; flex-shrink: 0; }
  .analyst-title { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; color: rgba(243,237,232,0.65); }
  .roadmap-ref { font-size: 9.5px; font-weight: 500; padding: 3px 8px; border-radius: 10px; background: rgba(255,255,255,0.14); color: #f3ede8; white-space: nowrap; }
  .analyst-body { font-size: 13px; line-height: 1.65; color: #f3ede8; }
  .analyst-body b { font-weight: 500; color: #fff; }
  .analyst-body .rec { display: block; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.18); color: var(--mustard); }
  .analyst-body .decision { font-size: 11px; color: rgba(243,237,232,0.55); margin-top: 6px; }
  .insight-banner { background: var(--bg-accent); border: 0.5px solid var(--border); border-radius: 12px; padding: 12px 16px; margin-bottom: 18px; font-size: 12.5px; color: var(--text-accent); line-height: 1.55; }
  .insight-banner.warn { background: var(--bg-warning); color: var(--text-warning); }
  .insight-banner.success { background: var(--bg-success); color: var(--text-success); }
  .insight-banner.danger { background: var(--bg-danger); color: var(--text-danger); }
  .insight-label { font-size: 9.5px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 4px; opacity: 0.75; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 14px; }
  @media (max-width: 900px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
  .chart-card { background: var(--surface-2); border: 0.5px solid var(--border); border-radius: 12px; padding: 16px; }
  .chart-card.full { margin-bottom: 14px; }
  .card-title { font-size: 12.5px; font-weight: 500; color: var(--text-primary); margin-bottom: 2px; }
  .card-sub { font-size: 10.5px; color: var(--text-muted); margin-bottom: 12px; }
  .card-take { font-size: 11.5px; color: var(--text-accent); background: var(--bg-accent); border-radius: 6px; padding: 7px 10px; margin-top: 10px; line-height: 1.5; }
  .chart-wrap { position: relative; width: 100%; }
  .legend { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 10px; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: 11.5px; color: var(--text-secondary); }
  .legend-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }
  .table-scroll { max-height: 560px; overflow-y: auto; border: 0.5px solid var(--border); border-radius: 12px; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
  .data-table thead th { position: sticky; top: 0; background: var(--surface-1); z-index: 2; text-align: right; color: var(--text-muted); font-weight: 500; font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.4px; padding: 8px 10px; border-bottom: 1px solid var(--border-strong); white-space: nowrap; cursor: help; }
  .data-table thead th:first-child { text-align: left; }
  .data-table td { padding: 6px 10px; border-bottom: 0.5px solid var(--border); color: var(--text-secondary); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .data-table td:first-child { text-align: left; color: var(--text-primary); font-weight: 500; }
  .data-table tr:hover td { background: var(--surface-1); }
  .cell-neg { color: var(--text-danger) !important; font-weight: 500; background: var(--bg-danger); }
  .cell-warn { color: var(--text-warning) !important; background: var(--bg-warning); }
  .cell-pos { color: var(--text-success) !important; }
  .row-flag { border-left: 2px solid var(--text-danger); }
  .table-legend { display: flex; gap: 16px; font-size: 10.5px; color: var(--text-muted); margin: 8px 2px 14px; flex-wrap: wrap; }
  .table-legend span { display: flex; align-items: center; gap: 5px; }
  .dot-sq { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
  .funnel-steps { display: flex; flex-direction: column; gap: 0; }
  .funnel-step { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 0.5px solid var(--border); }
  .funnel-step:last-child { border-bottom: none; }
  .f-label { width: 130px; font-size: 12px; color: var(--text-secondary); flex-shrink: 0; }
  .f-bar-wrap { flex: 1; } .f-bar { height: 22px; border-radius: 4px; background: var(--plum); opacity: 0.88; transition: width 0.4s; display: flex; align-items: center; padding-left: 8px; }
  .f-bar-val { font-size: 11px; font-weight: 500; color: white; white-space: nowrap; }
  .f-meta { width: 100px; text-align: right; flex-shrink: 0; }
  .f-pct { font-size: 12px; font-weight: 500; color: var(--text-primary); } .f-drop { font-size: 10px; color: var(--text-danger); } .f-drop.ok { color: var(--text-success); }
  .section-title { font-size: 11.5px; font-weight: 500; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.6px; margin: 22px 0 10px; }
  .sprint-card { background: var(--surface-2); border: 0.5px solid var(--border); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; display: flex; gap: 12px; }
  .sprint-priority { width: 36px; height: 20px; border-radius: 4px; font-size: 10px; font-weight: 500; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
  .p0 { background: var(--bg-danger); color: var(--text-danger); } .p1 { background: var(--bg-warning); color: var(--text-warning); } .p2 { background: var(--bg-accent); color: var(--text-accent); }
  .sprint-body { flex: 1; } .sprint-title { font-size: 13px; font-weight: 500; color: var(--text-primary); margin-bottom: 3px; }
  .sprint-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.5; }
  .sprint-tags { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
  .tag { font-size: 10px; padding: 2px 8px; border-radius: 10px; background: var(--surface-1); color: var(--text-muted); border: 0.5px solid var(--border); }
  .gap-card { background: var(--surface-1); border: 1px dashed var(--border-strong); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; }
  .gap-title { font-size: 12.5px; font-weight: 500; color: var(--text-primary); margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }
  .gap-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.55; }
  .cross-table { width: 100%; border-collapse: collapse; font-size: 11px; }
  .cross-table th { background: var(--surface-1); padding: 7px 8px; font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 500; text-align: right; border-bottom: 1px solid var(--border-strong); cursor: help; }
  .cross-table th:first-child { text-align: left; }
  .cross-table td { padding: 6px 8px; text-align: right; border-bottom: 0.5px solid var(--border); color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .cross-table td:first-child { text-align: left; color: var(--text-primary); font-weight: 500; }
  .heat-cell { border-radius: 4px; padding: 3px 8px; display: inline-block; min-width: 46px; cursor: help; }
  .cro-matrix { width: 100%; border-collapse: collapse; font-size: 12px; }
  .cro-matrix th { background: var(--surface-1); padding: 8px; font-size: 10px; text-transform: uppercase; color: var(--text-muted); font-weight: 500; text-align: left; border-bottom: 1px solid var(--border-strong); }
  .cro-matrix td { padding: 9px 8px; border-bottom: 0.5px solid var(--border); vertical-align: top; }
  .prio-pill { font-size: 10px; font-weight: 500; padding: 3px 9px; border-radius: 10px; display: inline-block; white-space: nowrap; }
  .prio-high { background: var(--bg-danger); color: var(--text-danger); }
  .prio-med { background: var(--bg-warning); color: var(--text-warning); }
  .prio-low { background: var(--bg-success); color: var(--text-success); }
  .explain-box { background: var(--surface-1); border-left: 3px solid var(--mustard); border-radius: 0 8px 8px 0; padding: 10px 14px; margin-bottom: 12px; font-size: 12px; color: var(--text-secondary); line-height: 1.55; }
  .explain-box b { color: var(--text-primary); }
</style>
</head>
