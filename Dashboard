    {tier:'Tier 1', total:5768, pillow:2392, bedding:2050, petbed:778, case_:640},
    {tier:'Tier 2', total:1010, pillow:468, bedding:327, petbed:138, case_:96},
    {tier:'Tier 3', total:3112, pillow:1383, bedding:1044, petbed:400, case_:274},
  ];
  document.getElementById('tierCompositionBody').innerHTML = data.map(d => {
    const pct = v => (v/d.total*100).toFixed(1)+'%';
    return `<tr><td>${d.tier}</td><td>${d.total.toLocaleString('en-IN')}</td><td>${pct(d.pillow)}</td><td>${pct(d.bedding)}</td><td>${pct(d.petbed)}</td><td>${pct(d.case_)}</td></tr>`;
  }).join('');
}
